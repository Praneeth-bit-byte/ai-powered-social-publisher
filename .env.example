# Server-Side Environment Variables (Never expose to client bundle)
# ==============================================================================
# 1. NVIDIA API Key & NIM Models (Server-side only)
# Used for:
#  - Multimodal Vision Product Analysis & Brand Understanding (meta/llama-3.2-11b-vision-instruct)
#  - Product Metadata Extraction & Non-Fabricated Attributes
#  - Brand-Safe 9:16 Video Concepts, 3-Second Hook & Voiceover Script Generation (nvidia/llama-3.1-nemotron-70b-instruct)
#  - Shot-by-Shot Storyboard & Cinematic Video Prompts (nvidia/llama-3.1-nemotron-70b-instruct)
# Generate your key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Official NVIDIA NIM Base URL (Defaults to https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configurable Vision Model (verified on NVIDIA Build API Catalog)
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Text / Script / Storyboard Model: nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_TEXT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ==============================================================================
# 2. Audio & Media Synthesis Keys (Preserved from Milestone 2 & 3)
# Used for 24kHz Mono 16-bit WAV AI Voiceover Synthesis (gemini-3.8-flash-lite-tts),
# Optional Lyria Music Clips, Nano Banana Image Assets, and Veo Video Generation
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Image generation model: gemini-3.1-flash-lite-image
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Video generation model: veo-2.0-generate-001 (or separate Basic Motion/Slideshow fallback)
GOOGLE_VIDEO_MODEL=veo-2.0-generate-001

# Optional Port Override (Defaults to 3000)
PORT=3000
